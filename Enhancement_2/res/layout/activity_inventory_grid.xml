<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- App Toolbar with three-dot menu -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="Inventory App"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:menu="@menu/toolbar_menu"/>

        <!-- Search bar -->
        <SearchView
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:queryHint="Search by Name or SKU"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="780dp"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- HEADER ROW -->
        <LinearLayout
            android:id="@+id/header_row"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:background="#1976D2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Image column spacer -->
            <View
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/header_name"
                android:layout_width="70dp"
                android:layout_height="30dp"

                android:gravity="center_vertical"
                android:text="@string/name"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/name_sort_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/down_arrow"/>

            <TextView
                android:id="@+id/header_sku"
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/sku"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/sku_sort_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/down_arrow"/>

            <TextView
                android:id="@+id/header_quantity"
                android:layout_width="15dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/qty"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/qty_sort_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/down_arrow"/>

            <!-- Delete column spacer -->
            <View
                android:layout_width="10dp"
                android:layout_height="48dp" />

        </LinearLayout>

        <!-- RecyclerView setup to display inventory items as a list-->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/inventory_grid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/add_item"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_row"
            android:overScrollMode="always"
            android:scrollbars="vertical"
            tools:listitem="@layout/inventory_items" />

        <!-- Add Item button-->
        <Button
            android:id="@+id/add_item"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/add_item"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:backgroundTint="#388E3C"
            app:cornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
