<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toolbar with three-dot menu -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="Inventory App"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:menu="@menu/toolbar_menu"/>

    </com.google.android.material.appbar.AppBarLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Notification Settings text bar at top of page -->
        <TextView
            android:id="@+id/notification_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1976D2"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/notification_settings"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Allow SMS Notifications card  -->
        <androidx.cardview.widget.CardView
            android:id="@+id/notify_box"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginTop="36dp"
            app:cardCornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/notification_settings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp">

                <!-- Allow SMS Notifications text -->
                <TextView
                    android:id="@+id/smsLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/allow_sms_notifications"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/switchSMS"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5" />

                <!-- Allow SMS Notifications switch (on/off) -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSMS"
                    android:layout_width="76dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="36dp"
                    android:checked="true"
                    android:scaleX="1.5"
                    android:scaleY="1.3"
                    android:trackTint="#388E3C"
                    android:thumbTint="#D32F2F"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.466" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Notify when quantity card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/quantity_box"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginTop="38dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/notify_box"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp">

                <!-- Notify when quantity text -->
                <TextView
                    android:id="@+id/quantity_Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/notify_when_quantity"
                    android:textSize="22sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/quantity_blank"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Notify when quantity space to add numeric value -->
                <EditText
                    android:id="@+id/quantity_blank"
                    android:layout_width="90dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="12dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:hint="@string/_0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Save settings button -->
        <Button
            android:id="@+id/save_button"
            android:layout_width="267dp"
            android:layout_height="63dp"
            android:layout_marginTop="52dp"
            android:text="@string/save_settings"
            android:textSize="24sp"
            app:backgroundTint="#388E3C"
            app:cornerRadius="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/quantity_box" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
